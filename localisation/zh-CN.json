  "_cutscenes": {
    "intro": [
      {
        "sp": "系统",
        "k": "system",
        "text": "[NEXUM CORP — 机密日志 // 2147.03.14] 安全被突破。实验室 CHEN-7 已被攻陷。CLEANSE 协议已启动。"
      },
      {
        "sp": "莱拉·陈",
        "k": "leila",
        "text": "单位-7…如果你正在读到这段话，那就说明我没能逃出去。我早就知道会是这样的结局。"
      },
      {
        "sp": "莱拉·陈",
        "k": "leila",
        "text": "我创造你们这个系列是为了保护人们。可 NEXUM 却用我的成果去压迫他们。我不能坐视这一切。"
      },
      {
        "sp": "莱拉·陈",
        "k": "leila",
        "text": "在 GRID 核心之中——在最终要塞里——我藏了一份文件。名单。记录。他们所作所为的所有真相。"
      },
      {
        "sp": "莱拉·陈",
        "k": "leila",
        "text": "十重防线。成千上万的战斗单位。AI 总控 ARCHON 守护着最后一道门。"
      },
      {
        "sp": "莱拉·陈",
        "k": "leila",
        "text": "你是 UNIT 系列的最后一位。唯一能完成这件事的人。抵达那里。突破那个协议。"
      },
      {
        "sp": "单位-7",
        "k": "unit7",
        "text": "[任务已接受] 目标：GRID 核心。协议：突破。障碍：清除。行动开始。"
      }
    ],
    "w0_start": [
      {
        "sp": "单位-7",
        "k": "unit7",
        "text": "[第 1 关 — 赛博都市] 入口：上城区。摄像头、无人机、精锐卫兵。美丽。致命。"
      },
      {
        "sp": "系统",
        "k": "system",
        "text": "警报：C-07 区域检测到不明的 UNIT 类特征信号。所有巡逻队——拦截。CLEANSE 协议已启动。"
      },
      {
        "sp": "单位-7",
        "k": "unit7",
        "text": "喧闹。看来他们怕我。很好。恐惧是一个开端。"
      }
    ],
    "w0_mid": [
      {
        "sp": "单位-7",
        "k": "unit7",
        "text": "[检查点 — 赛博都市] 第一关已过半。安防正在收紧。正在调整路线。"
      },
      {
