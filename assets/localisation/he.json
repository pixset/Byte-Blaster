  "wn103a7": "אויבים קפואים הפכו לגושי קרח: נופלים, מחליקים ומפילים זה את זה בשרשרת",
  "wn103a8": "במפת העולם רואים כמה מטבעות אספת בסך הכול ובכל שלב",
  "wn103a9": "כפתור החשבון מציג את התמונה שלך מפרופיל Pixset Studio",
  "wn103a10": "סגנון משחק בהגדרות: הרגוע שומר את נקודת הביקורת גם אחרי כל החיים, ונפילה מחזירה אותך למדף שממנו קפצת",
  "wn103a11": "מצב צופה ברשת: אחרי שיצאת, אתה צופה באחרים, עובר ביניהם ויכול לצאת בלי לחכות לסוף השלב",
  "wn103a12": "עולם משותף ברשת: מטבעות, בלוקים, בונוסים, גבישים ומפתחות משותפים לכל החדר, וכולם רואים את היריות של כולם",
  "wn103a13": "חץ מצביע על שחקנים מחוץ למסך — רואים מי רץ קדימה, מי פיגר ובכמה",
  "wn103a14": "הודעות בפינה: מי נכנס לחדר ומי יצא",
  "wn103a15": "המארח יכול לאפשר הצטרפות לשלב שכבר התחיל — אחרת החדש מחכה לשלב הבא",
  "wn103a16": "שלב היום: חמישה אתגרים, חדשים בכל יום — קל, רגיל, קשה ושניים אקראיים. כמה ניסיונות שתרצה, נספר הטוב ביותר",
  "wn103a17": "רוח הריצה הטובה ביותר רצה לצדך: השיא שלך, מוביל היום או מוביל השלב. מופעל בהגדרות, כבוי כברירת מחדל",
  "wn103a18": "אפשר לצפות בטבלאות השיאים לפי עולם, לפי המדינה שלך או רק בין חברים",
  "wn103a19": "כניסה לחשבון בעזרת כינוי, ולא רק בדוא\"ל",
  "wn103a20": "מדור „מקוון“ ריכז את שלב היום ואת המשחק המשותף במקום אחד",
  "wn103c1": "ההגדרות עברו לפינת המסך, כמו כפתור החשבון",
  "wn103c2": "במסך הטעינה רואים אחוזים, שלבים וכמה נתונים כבר הגיעו",
  "wn103c3": "המאפיינים המיוחדים של השלבים נעשו נדירים: לכל היותר אחד לשלב, ובשליש מהשלבים אין בכלל",
  "wn103c4": "תורן: ככל שתתפוס את הדגל גבוה יותר, כך תקבל יותר נקודות",
  "wn103c5": "המשחק נטען מהר יותר: הוא טוען שפה אחת ולא את כל החמישים בבת אחת",
  "wn103c6": "הגדרת איכות הגרפיקה שולטת עכשיו בכל הזוהר, ולא בחלק ממנו",
  "wn103c7": "בפרופיל הציבורי של השחקן יש הרבה יותר מספרים: שיאים, מטבעות, בוסים, סודות, סטטיסטיקת קרב",
  "wn103c8": "חדרי ריבוי משתתפים עובדים גם היכן שהשרת הישן אינו נגיש: המשחק מוצא בעצמו דרך פעילה, וקוד החדר עובד ללא קשר לשאלה למי נפתח איזה שרת",
  "wn103c9": "הזוהר הוגבל למאה אחוז: מעל זה הוא כבר לא האיר את התמונה אלא הציף אותה",
  "wn103c10": "מונה הפריימים מציג מספר כן וזמן פריים, והמסגרת עם הרקע הוסרו — הוא כבר לא מסתיר דבר",
  "wn103c11": "בעולם הקשת כל האובייקטים מקבלים את הצבע, ולא כמעט כולם; כשהשבירה כבויה הנצנוץ קופא למעבר קבוע והפריים עולה פחות",
  "wn103f1": "הסיום כבר לא מופיע בתוך חדר בונוס",
  "wn103f2": "כבר אי אפשר לצאת מחדר בונוס מלמעלה ולרוץ לסיום",
  "wn103f3": "בלוק נסתר כבר לא ניצב מול גביש ונועל אותו",
  "wn103f4": "עולם הלבה כבר לא נתקע בציור הפריים הראשון",
  "wn103f5": "תוקן כשל ציור נדיר: בחלק מהשלבים אויבים יכלו להיעלם מהמסך",
  "wn103f6": "הכפתור „מה חדש“ כבר לא נתלה על מסכי הניצחון וההפסד",
  "wn103f7": "מוות בפרולוג מפעיל את הפרולוג מחדש במקום לזרוק אותך לשלב הראשון של המסע",
  "wn103f8": "הדגל השני באמצע השלב הוסר: לשלב שוב יש סיום אחד",
  "wn103f9": "מכות תכופות מלמטה בבלוק מטבעות כבר לא מעיפות את השחקן הצדה",
  "wn103f10": "יציאת שחקן מחדר הרשת כבר לא מאלצת את האחרים לחכות לו ליד הדגל",
  "wn103f11": "החלפת מארח באמצע השלב כבר לא תוקעת את החדר לנצח",
  "wn103f12": "יציאה מהחדר לתפריט כבר לא משאירה שחקנים זרים במשחק היחיד הבא שלך",
  "wn103f13": "שחקנים זרים כבר לא מחליקים בשלב בלי הנפשה — הצעד, הנחיתה והמנוחה שלהם עובדים",
  "wn103f14": "אחרי היציאה מהחדר נעלמים כפתורי המגע",
  "wn103f15": "מהירות ההנפשות כבר לא תלויה בקצב הפריימים: במסכים מהירים המטבעות, הקפיצים, מפת העולם והסצנות רצו פי שניים וחצי מהר יותר",
  "wn103f16": "הרוח כבר לא נעלמת באמצע השלב, וניסיון כושל כבר לא דורס את ההקלטה של ריצה שהושלמה",
  "wn103f17": "התקנת עדכון כבר לא מנתקת אותך מהחשבון",
  "wn103f18": "ברשת שחקנים זרים נעים בצורה חלקה במסך בכל תדר",
